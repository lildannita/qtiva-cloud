# qtiva-runner:ubuntu-qt5.15-wayland
# Runner контейнер для запуска Qt GUI тестов в Ubuntu с Wayland

FROM ubuntu:22.04

LABEL maintainer="qtiva-cloud"
LABEL description="Qtiva Runner - Ubuntu 22.04 + Qt 5.15 + Wayland (headless Weston)"

ENV DEBIAN_FRONTEND=noninteractive

# Устанавливаем зависимости
RUN apt-get update && apt-get install -y \
    # Базовые утилиты
    bash \
    coreutils \
    tar \
    gzip \
    jq \
    # Qt 5.15 runtime
    libqt5core5a \
    libqt5gui5 \
    libqt5widgets5 \
    libqt5qml5 \
    libqt5quick5 \
    libqt5quickcontrols2-5 \
    libqt5svg5 \
    qml-module-qtquick2 \
    qml-module-qtquick-controls2 \
    qml-module-qtquick-window2 \
    qml-module-qtgraphicaleffects \
    qtwayland5 \
    # Wayland compositor
    weston \
    libwayland-client0 \
    libwayland-server0 \
    # Шрифты
    fonts-dejavu-core \
    # Mesa для software rendering
    libgl1-mesa-dri \
    libgl1-mesa-glx \
    mesa-utils \
    # D-Bus
    dbus \
    && \
    # Очистка
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Создаём пользователя для запуска тестов
RUN useradd -m -s /bin/bash qtiva && \
    mkdir -p /work /artifacts /input && \
    chown -R qtiva:qtiva /work /artifacts

# Копируем runner скрипт
COPY runner.sh /qtiva/runner
RUN chmod +x /qtiva/runner

# Настройка окружения
ENV HOME=/home/qtiva
ENV USER=qtiva
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Запуск от пользователя qtiva
USER qtiva
WORKDIR /work

# Точка входа
ENTRYPOINT ["/qtiva/runner"]
